{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vdebut-discovery",
  "main": "src/debutAutomationWorker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "0 0 * * *",
      "0 12 * * *",
      "0 1 * * MON",
      "* * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 5000,
    "subrequests": 400
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vdebut-db",
      "database_id": "888a8c04-5657-4bff-9b50-5002a47ac7c7"
    }
  ],
  "services": [
    {
      "binding": "SITE",
      "service": "streaming"
    }
  ],
  "vars": {
    "AUTOMATION_VERSION": "2026-11-12.2",
    "SMOKE_TEST_UNTIL": "",
    "BACKFILL_FROM": "2026-11-01",
    "BACKFILL_TO": "2026-11-11",
    "BACKFILL_UNTIL": "2026-11-12T06:26:53.562Z"
  }
}